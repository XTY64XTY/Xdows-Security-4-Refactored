<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Xdows.Security.Client.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid x:Name="RootGrid" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自定义标题栏：与原客户端一致，左侧图标 + 标题，右侧为窗口按钮区域 -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Height="40" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Image Source="ms-appx:///Assets/logo.ico" Width="28" Height="28" />
                <TextBlock
                    x:Name="TitleText"
                    Text="Xdows Security"
                    FontSize="14"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center" />
            </StackPanel>

            <Button
                x:Name="DevToolsButton"
                Content="开发者工具"
                FontSize="12"
                Padding="8,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,0,0"
                Visibility="Collapsed"
                Click="OnDevToolsClick" />
        </Grid>

        <controls:WebView2 x:Name="WebView" Grid.Row="1" />
    </Grid>
</Window>
