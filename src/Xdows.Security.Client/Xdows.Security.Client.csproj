<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Xdows.Security.Client</RootNamespace>
    <AssemblyName>Xdows.Security.Client</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 框架依赖：运行时不随包分发，目标机需要 .NET 10 运行时与 Windows App Runtime 2.x。
         NativeAOT 与 .NET 框架依赖互斥（AOT 产物自带运行时）；而且当前 SDK 11.0.100-rc.3 下
         dotnet publish + PublishAot 会让 XamlCompiler 收到空引用列表并报 WMC1007，
         详见 docs/port-map.md「已知限制」。 -->
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 只引用实际用到的组件：元包 Microsoft.WindowsAppSDK 还会带上 AI / ML / Widgets / Search，
         其中 onnxruntime + DirectML 约 40 MB，本项目完全用不到。 -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\logo.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
