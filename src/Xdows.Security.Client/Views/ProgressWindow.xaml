<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Xdows.Security.Client.Views.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="White" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 图标 + 标题，对应原窗口左上角的图片框与标签 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
            <Image Source="ms-appx:///Assets/logo.ico" Width="24" Height="24" VerticalAlignment="Center" />
            <TextBlock
                x:Name="CaptionText"
                FontSize="16"
                VerticalAlignment="Center" />
        </StackPanel>

        <ProgressBar
            x:Name="Progress"
            Grid.Row="1"
            Height="6"
            Margin="0,16,0,0"
            IsIndeterminate="True" />

        <TextBlock
            x:Name="StatusText"
            Grid.Row="2"
            Margin="0,16,0,0"
            TextWrapping="Wrap"
            VerticalAlignment="Top" />

        <CheckBox
            x:Name="TopmostCheckBox"
            Grid.Row="3"
            Content="总在最前"
            Margin="0,8,0,0"
            Checked="OnTopmostChanged"
            Unchecked="OnTopmostChanged" />
    </Grid>
</Window>
