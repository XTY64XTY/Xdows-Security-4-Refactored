<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Xdows.Security.Host</RootNamespace>
    <AssemblyName>Xdows.Security.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 宿主不加载任何插件的元数据，可以裁剪；插件程序集是独立编译的，不受影响。
         不能用 NativeAOT：插件靠 AssemblyLoadContext 动态加载，AOT 下不支持。 -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xdows.Security.Core\Xdows.Security.Core.csproj" />
    <ProjectReference Include="..\Xdows.Security.Server\Xdows.Security.Server.csproj" />
    <ProjectReference Include="..\Xdows.Security.Plugin.Abstractions\Xdows.Security.Plugin.Abstractions.csproj" />
  </ItemGroup>

  <!-- 网页资源、批处理脚本：输出到与原项目一致的 Bin\ 结构 -->
  <ItemGroup>
    <Content Include="..\..\assets\web\**\*" LinkBase="Bin\Html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\bin-function\*" LinkBase="Bin\Function" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\plugins\**\*" LinkBase="Plugins" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 插件以独立程序集编译，再按 Plugins\<名称>\Files\Main.dll 的契约复制 -->
  <Target Name="BuildPlugins">
    <MSBuild Projects="..\Xdows.Security.Plugins.Files\Xdows.Security.Plugins.Files.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;PublishReadyToRun;PublishSingleFile">
      <Output TaskParameter="TargetOutputs" ItemName="FilesPluginOutput" />
    </MSBuild>
    <MSBuild Projects="..\Xdows.Security.Plugins.Process\Xdows.Security.Plugins.Process.csproj" Targets="Build" Properties="Configuration=$(Configuration)" RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;PublishReadyToRun;PublishSingleFile">
      <Output TaskParameter="TargetOutputs" ItemName="ProcessPluginOutput" />
    </MSBuild>
  </Target>

  <Target Name="CopyPluginsToOutput" AfterTargets="Build" DependsOnTargets="BuildPlugins">
    <Copy SourceFiles="@(FilesPluginOutput)" DestinationFolder="$(OutDir)Plugins\Files\Files" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ProcessPluginOutput)" DestinationFolder="$(OutDir)Plugins\Process\Files" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish 只搬运已知输出，插件程序集需要单独复制到发布目录 -->
  <Target Name="CopyPluginsToPublish" AfterTargets="Publish" DependsOnTargets="BuildPlugins">
    <Copy SourceFiles="@(FilesPluginOutput)" DestinationFolder="$(PublishDir)Plugins\Files\Files" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ProcessPluginOutput)" DestinationFolder="$(PublishDir)Plugins\Process\Files" SkipUnchangedFiles="true" />
  </Target>
</Project>
